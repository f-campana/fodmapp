{
  "name": "@fodmapp/mobile-prototype",
  "version": "0.3.5",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build:shared": "pnpm --filter @fodmapp/domain build && pnpm --filter @fodmapp/api-client build",
    "start": "pnpm run build:shared && expo start",
    "ios": "pnpm run build:shared && expo start --ios",
    "typecheck": "pnpm run build:shared && tsc --noEmit",
    "test": "pnpm run build:shared && node --import tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@clerk/expo": "^3.2.2",
    "@fodmapp/api-client": "workspace:*",
    "@fodmapp/design-tokens": "workspace:*",
    "@fodmapp/domain": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.7",
    "@react-navigation/native": "^7.3.7",
    "@react-navigation/native-stack": "^7.17.9",
    "expo": "~57.0.2",
    "expo-secure-store": "^57.0.0",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.25.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/react": "~19.2.10",
    "tsx": "^4.22.3",
    "typescript": "~6.0.3"
  }
}
